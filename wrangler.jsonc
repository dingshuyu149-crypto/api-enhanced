{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pudding-music-source",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "vars": {
    "ENABLE_GENERAL_UNBLOCK": "false",
    "ENABLE_PROXY": "false",
    "ENABLE_RANDOM_CN_IP": "false"
  }
}
